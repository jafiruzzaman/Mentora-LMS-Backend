{
  "name": "server",
  "version": "1.0.0",
  "author": "Mohammad-Jafiruzzaman",
  "description": "",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "prod": "NODE_ENV=production bun dist/index.js",
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:studio": "bunx drizzle-kit studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "bun run format:check && bun run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@neon/config": "^1.8.4",
    "@neon/env": "^1.5.1",
    "@neondatabase/serverless": "^1.2.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.11",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.14",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "slugify": "^1.6.9",
    "stripe": "^23.0.0",
    "supertest": "^7.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "latest",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  }
